  "main": "index.ts",
  "license": "MIT",
  "author": "alonw0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "claude-code",
    "agent-mesh",
    "inter-agent-messaging"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alonw0/pi-claude-link.git"
  },
  "files": [
    "index.ts",
    "claude-protocol.ts",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
